set_location_assignment PIN_AE19 -to HEX4_o[4]
set_location_assignment PIN_AF19 -to HEX4_o[5]
set_location_assignment PIN_AE18 -to HEX4_o[6]
# PORT_HEX5
set_location_assignment PIN_AD18 -to HEX5_o[0]
set_location_assignment PIN_AC18 -to HEX5_o[1]
set_location_assignment PIN_AB18 -to HEX5_o[2]
set_location_assignment PIN_AH19 -to HEX5_o[3]
set_location_assignment PIN_AG19 -to HEX5_o[4]
set_location_assignment PIN_AF18 -to HEX5_o[5]
set_location_assignment PIN_AH18 -to HEX5_o[6]
# PORT_PB (GPI) -> KEY1..KEY3 (KEY0 is rst_i); unused by test0, wired for P4
set_location_assignment PIN_M21 -to PB_i[0]
set_location_assignment PIN_N21 -to PB_i[1]
set_location_assignment PIN_R24 -to PB_i[2]
set_global_assignment -name POWER_USE_INPUT_FILES ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE 12.5%
set_global_assignment -name POWER_INPUT_FILE_NAME ../../Quartus/RV32IMscMCU/power_test1_gate.vcd -section_id power_test1_gate.vcd
set_instance_assignment -name POWER_READ_INPUT_FILE power_test1_gate.vcd -to RV32I_CORE
set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name USE_SIGNALTAP_FILE ../../Quartus/RV32IMscMCU/stp1.stp
set_global_assignment -name SDC_FILE ../../Quartus/RV32IMscMCU/RV32I_CORE.sdc
set_global_assignment -name VHDL_FILE RV32I_CORE.vhd
set_global_assignment -name VHDL_FILE div_stall_ctrl.vhd
set_global_assignment -name VHDL_FILE divider.vhd
set_global_assignment -name VHDL_FILE DMEMORY.VHD
set_global_assignment -name VHDL_FILE EXECUTE.VHD
