set_location_assignment PIN_W21 -to HEX1_o[2]
set_location_assignment PIN_W22 -to HEX1_o[3]
set_location_assignment PIN_W25 -to HEX1_o[4]
set_location_assignment PIN_U23 -to HEX1_o[5]
set_location_assignment PIN_U24 -to HEX1_o[6]
# PORT_HEX2
set_location_assignment PIN_AA25 -to HEX2_o[0]
set_location_assignment PIN_AA26 -to HEX2_o[1]
set_location_assignment PIN_Y25 -to HEX2_o[2]
set_location_assignment PIN_W26 -to HEX2_o[3]
set_location_assignment PIN_Y26 -to HEX2_o[4]
set_location_assignment PIN_W27 -to HEX2_o[5]
set_location_assignment PIN_W28 -to HEX2_o[6]
# PORT_HEX3
set_location_assignment PIN_V21 -to HEX3_o[0]
set_location_assignment PIN_U21 -to HEX3_o[1]
set_location_assignment PIN_AB20 -to HEX3_o[2]
set_location_assignment PIN_AA21 -to HEX3_o[3]
set_location_assignment PIN_AD24 -to HEX3_o[4]
set_location_assignment PIN_AF23 -to HEX3_o[5]
set_location_assignment PIN_Y19 -to HEX3_o[6]
# PORT_HEX4
set_location_assignment PIN_AB19 -to HEX4_o[0]
set_location_assignment PIN_AA19 -to HEX4_o[1]
set_location_assignment PIN_AG21 -to HEX4_o[2]
