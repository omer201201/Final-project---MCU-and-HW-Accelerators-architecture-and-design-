set_global_assignment -name VHDL_FILE cond_compilation_package.vhd
set_global_assignment -name VHDL_FILE gpio.vhd
set_global_assignment -name VHDL_FILE seg7.vhd
set_global_assignment -name VHDL_FILE bus_interface.vhd
set_global_assignment -name VHDL_FILE BasicTimer.vhd
set_global_assignment -name VHDL_FILE bt_regs.vhd
set_global_assignment -name VHDL_FILE bt_counter.vhd
set_global_assignment -name VHDL_FILE bt_prescaler.vhd
set_global_assignment -name VHDL_FILE bt_output_unit.vhd
set_global_assignment -name VHDL_FILE bt_capture.vhd
set_global_assignment -name VHDL_FILE intr_ctrl.vhd
set_global_assignment -name VHDL_FILE intr_fsm.vhd
set_global_assignment -name SIGNALTAP_FILE ../../Quartus/RV32IMscMCU/stp1.stp
set_global_assignment -name ENABLE_OCT_DONE OFF
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name ENABLE_BOOT_SEL_PIN OFF
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CRC_ERROR_OPEN_DRAIN OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -rise
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -fall
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -rise
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -fall

# ==== Basic Timer PWM output (DE2-115 Expansion Header J15, GPIO[9]) ====
# GPIO[9] = PIN_AE15  (source: DE2_115_pin_assignments.csv). I/O bank 4.
# Scope CH1 probe point; GND on the adjacent header pin.
# NOTE: no IO_STANDARD is set here on purpose. Every other pin in this project
# uses the Quartus default (2.5 V on Cyclone IV E), which is what the
# hardware-validated GPIO build used. Forcing "3.3-V LVTTL" on this one pin
# makes it incompatible with the rest of bank 4 (which also carries HEX3/4/5)
# and the Fitter rejects the design with error 169026. If you later want the
# whole board at the Terasic-nominal 3.3 V, set it for ALL pins, not just this one.
set_location_assignment PIN_AE15 -to pwm_o

# ==== Internal observation outputs - no physical pins ====
# btifg_o / intr_o exist for simulation and Signal-Tap only. VIRTUAL_PIN keeps
# the ports (so the testbenches still elaborate) without burning board pins.
# NOTE: the spec asks these to be removed via a generate parameter for the
# final submission - this is the interim measure.
set_instance_assignment -name VIRTUAL_PIN ON -to btifg_o
set_instance_assignment -name VIRTUAL_PIN ON -to intr_o

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top